# URL pubblico dello shim (hostname Tailscale Funnel, senza porta se su 443)
ISSUER_URL=https://lucas-macbook-air.tail234659.ts.net

# Porta locale su cui gira uvicorn (proxata da Tailscale Funnel)
PORT=8420

# Endpoint HTTPS locale del plugin "Local REST API with MCP" di Obsidian
OBSIDIAN_MCP_URL=https://127.0.0.1:27124
# Il plugin usa un certificato self-signed: lascia false
OBSIDIAN_VERIFY_SSL=false

# API key del plugin Obsidian (Impostazioni -> Local REST API -> API key)
OBSIDIAN_API_KEY=CHANGE_ME

# Generati automaticamente al primo avvio se assenti: non serve compilarli a mano
JWT_SECRET=
CONSENT_PASSCODE=

# TTL in secondi
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300

# Percorso del database SQLite (default: accanto a questo file)
DB_PATH=
