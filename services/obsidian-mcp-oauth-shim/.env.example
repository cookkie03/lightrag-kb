# URL pubblico dello shim (hostname Tailscale Funnel, senza porta se su 443)
ISSUER_URL=https://your-node.your-tailnet.ts.net

# Porta locale su cui gira uvicorn (proxata da Tailscale Funnel)
SHIM_BIND_HOST=127.0.0.1
SHIM_BIND_PORT=8420
PORT=8420

# Endpoint locale del backend LightRAG MCP già esposto in streamable-http
LIGHTRAG_MCP_URL=http://127.0.0.1:8743/mcp
LIGHTRAG_MCP_VERIFY_SSL=false

# Generati automaticamente al primo avvio se assenti: non serve compilarli a mano
JWT_SECRET=
CONSENT_PASSCODE=

# TTL in secondi
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300

# Percorso del database SQLite (default: accanto a questo file)
DB_PATH=
