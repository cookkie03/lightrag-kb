#!/usr/bin/env bash
# Wrapper per ragcli.py che usa il runtime condiviso del progetto.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
HERE="$(cd "$(dirname "$SOURCE")" && pwd)"
ENGINE_PY="$HERE/../.venv/bin/python"
if [ -x "$ENGINE_PY" ]; then
  exec "$ENGINE_PY" "$HERE/ragcli.py" "$@"
fi
exec python3 "$HERE/ragcli.py" "$@"
