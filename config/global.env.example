# LightRAG-KB — configurazione centrale condivisa
# Unico runtime condiviso del progetto.
# setup.sh mantiene questi path allineati al clone locale.
ENGINE_PYTHON=.venv/bin/python
LIGHTRAG_SERVER_BIN=.venv/bin/lightrag-server
DOCLING_PYTHON=.venv/bin/python
DOCLING_LANG=it,en
DOCLING_TIMEOUT=3600
DOCLING_PLATFORM=auto
DOCLING_OCR_ENGINE=auto
DOCLING_ASR_ENGINE=auto
DOCLING_ACCELERATOR=auto
DOCLING_ENABLE_TABLES=1
DOCLING_ENABLE_CODE_ENRICHMENT=1
DOCLING_ENABLE_FORMULA_ENRICHMENT=1
DOCLING_IMAGE_SCALE=2.0
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8743
MCP_PATH=/mcp
PUBLIC_MCP_KB=
SHIM_BIND_HOST=127.0.0.1
SHIM_BIND_PORT=8420
TAILSCALE_FUNNEL_PORT=8443
SHIM_PUBLIC_URL=https://your-node.your-tailnet.ts.net

# --- Provider globale: ollama | openrouter ---
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434

# --- LLM per estrazione entità/relazioni ---
LLM_MODEL=qwen3.5:4b
OLLAMA_LLM_NUM_CTX=8192
OLLAMA_LLM_NUM_PREDICT=4096

# --- Robustezza pipeline di ingest ---
LLM_TIMEOUT=900
TIMEOUT=900
# 1 = meno RAM durante ingest, più lento; 2 = compromesso più veloce.
MAX_ASYNC=1
EMBEDDING_TIMEOUT=120

# --- Embedding ---
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
OLLAMA_EMBEDDING_NUM_CTX=8192

# --- OpenRouter (usato se LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_HOST=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openrouter/owl-alpha
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_EMBEDDING_DIM=2048

# --- Rerank (disabilitato: LightRAG non supporta rerank via Ollama) ---
RERANK_BINDING=null

# --- Qualità RAG ---
SUMMARY_LANGUAGE=Italian
MAX_GLEANING=1
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=150
COSINE_THRESHOLD=0.25

# --- Porta di partenza per le KB (incrementata automaticamente) ---
BASE_PORT=9621
